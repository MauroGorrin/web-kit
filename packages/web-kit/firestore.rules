rules_version = '2';

// Reglas base de @mgorrin/web-kit. El paso 3 (auth-rbac) las completa con las
// colecciones de auth/roles; los pasos 4-12 añaden una sección por módulo.
// Cada proyecto de cliente despliega ESTE archivo (vía firebase.json) contra
// SU PROPIO proyecto de Firebase — no hay base de datos compartida entre clientes.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(r) {
      return isSignedIn() && role() == r;
    }

    function isAdminOrAbove() {
      return isSignedIn() && role() in ['admin', 'super_admin'];
    }

    // --- users (auth-rbac, paso 3) ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdminOrAbove());
      allow write: if hasRole('super_admin');
    }

    // --- sedes (multi-location, paso 4) ---
    match /sedes/{sedeId} {
      allow read: if true;
      allow write: if isAdminOrAbove();
    }

    // --- especialistas (admin-panel, paso 7) ---
    match /especialistas/{especialistaId} {
      allow read: if true;
      allow write: if isAdminOrAbove();
    }

    // --- citas (scheduling, paso 5) ---
    match /citas/{citaId} {
      // Solo el dueño (`clientUid`) o un admin puede leer — antes cualquier
      // usuario autenticado podía leer las citas de TODOS los clientes.
      allow read: if isAdminOrAbove() || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      // El estado inicial de una Cita creada por el cliente siempre es
      // "scheduled" (lo mismo que fuerza `scheduling/normalize.ts` en el
      // camino server) y `clientUid` no puede suplantar a otro usuario.
      allow create: if isSignedIn()
        && request.resource.data.status == 'scheduled'
        && (request.resource.data.clientUid == null
          || request.resource.data.clientUid == request.auth.uid);
      allow update, delete: if isAdminOrAbove() || (isSignedIn() && resource.data.clientUid == request.auth.uid);
    }

    // --- leads (crm, paso 8) ---
    match /leads/{leadId} {
      allow read, write: if isAdminOrAbove();
    }

    // --- productos / pedidos (ecommerce, paso 12) ---
    match /productos/{productoId} {
      allow read: if true;
      allow write: if isAdminOrAbove();
    }

    match /pedidos/{pedidoId} {
      allow read: if isAdminOrAbove() || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdminOrAbove();
    }

    // --- stripe_webhook_events (payments, paso 11) ---
    // Marcador de idempotencia por `event.id` de Stripe — solo lo toca el
    // webhook vía SDK admin (bypassa estas reglas). Nunca leído/escrito
    // desde un cliente; entrada explícita por claridad aunque el catch-all
    // de abajo ya lo cubriría.
    match /stripe_webhook_events/{eventId} {
      allow read, write: if false;
    }

    // Denegación por defecto para cualquier otra colección.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
