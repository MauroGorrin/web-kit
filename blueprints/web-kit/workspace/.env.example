# Firebase (cliente) — Consola Firebase > Configuración del proyecto > Tus apps
# Requerido desde el paso 3 (auth-rbac)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor) — Consola Firebase > Cuentas de servicio > Generar clave privada
# Requerido desde el paso 3 (auth-rbac)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Emuladores locales de Firebase — valores fijos para desarrollo/tests, no secretos
# Requerido desde el paso 3 (auth-rbac)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Calendly — URL pública del calendario del cliente
# Requerido desde el paso 5 (scheduling)
NEXT_PUBLIC_CALENDLY_URL=

# Resend — https://resend.com/api-keys
# Requerido desde el paso 9 (notifications)
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Google Analytics 4 — Admin de GA4 > Flujos de datos
# Requerido desde el paso 10 (seo-analytics)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe — https://dashboard.stripe.com/apikeys y https://dashboard.stripe.com/webhooks
# Requerido desde el paso 11 (payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# HubSpot — solo si modules.config.ts activa crm.externalSync (apagado por defecto)
# Requerido desde el paso 8 (crm), opcional hasta que se active el flag
HUBSPOT_API_KEY=
