{
  "name": "web-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo interno del starter kit @mgorrin/web-kit y su app plantilla.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter template dev",
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,auth \"vitest run tests/rules\"",
    "emulators:up": "firebase emulators:start --only firestore,auth",
    "emulators:exec": "firebase emulators:exec --only firestore,auth",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @mgorrin/web-kit build && changeset publish",
    "setup:client": "node scripts/setup.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.0.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@playwright/test": "^1.63.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.9",
    "@eslint/eslintrc": "^3.3.7",
    "prettier": "^3.9.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "@changesets/cli": "^3.0.2"
  }
}
